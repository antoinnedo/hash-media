<%# This partial is rendered for each comment %>
<div class="ml-8 mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200" id="comment-<%= comment.id %>">
  <p class="text-gray-600 text-sm">
    <strong><%= link_to comment.user.username, user_path(comment.user), class: "hover:underline" %></strong> commented:
  </p>
  <div class="prose prose-sm max-w-none mt-1">
    <%= comment.content %>
  </div>

  <% if user_signed_in? && comment.user == current_user %>
    <div class="text-xs mt-2">
      <%= button_to 'Delete', comment_path(comment), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
    </div>
  <% end %>

  <%# --- Render Responses (Replies) for this Comment --- %>
  <div class="mt-4" id="comment-<%= comment.id %>-responses">
    <%= render comment.responses %>
  </div>

  <%# --- Form to Create a New Response (Reply) --- %>
  <% if user_signed_in? %>
    <div class="mt-3">
      <%= form_with(model: [comment, Response.new], class: "flex items-start space-x-2") do |form| %>
        <%= form.text_area :content, rows: 1, class: "flex-grow block w-full rounded-md border-gray-300 shadow-sm sm:text-sm", placeholder: "Add a reply..." %>
        <%= form.submit "Reply", class: "cursor-pointer bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-1 px-3 rounded text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
