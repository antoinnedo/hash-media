<%# app/views/users/edit.html.erb %>
<%# This single file now contains the entire edit profile page, including the form. %>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-6 text-gray-800 border-b pb-4">Edit Your Profile</h1>

    <%#
      The form is now directly within this view.
      It uses `form_with` and points to the `update` action for the @user object.
      The @user variable must be set in your UsersController's `edit` action.
    %>
    <%= form_with(model: @user, local: true, html: { class: "space-y-6" }) do |form| %>

      <%# Display validation errors, if any exist. %>
      <% if @user.errors.any? %>
        <div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative" role="alert">
          <strong class="font-bold"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</strong>
          <ul class="mt-3 list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Form field for First Name %>
      <div class="field">
        <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :first_name,
          required: true,
          class: "mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>

      <%# Form field for Last Name %>
      <div class="field">
        <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :last_name,
          required: true,
          class: "mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>

      <%# Form field for Email %>
      <div class="field">
        <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email,
          required: true,
          class: "mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>

      <%# Form field for User Bio %>
      <div class="field">
        <%= form.label :bio, class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_area :bio, rows: 4, class: "mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
      </div>

      <%# Form field for Profile Picture upload %>
      <div class="field">
        <%= form.label :profile_picture, class: "block text-sm font-medium text-gray-700" %>
        <%= form.file_field :profile_picture, class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-600 hover:file:bg-indigo-100" %>
      </div>

      <%# Submit button %>
      <div class="actions">
        <%= form.submit "Update Profile", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
