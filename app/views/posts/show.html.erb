<div class="container mx-auto px-4 py-8">
  <div class="bg-white p-8 rounded-lg shadow-md">
    <p class="text-sm text-gray-500 mb-2">
      <%= link_to '← Back to all posts', posts_path, class: "hover:underline" %>
    </p>
    <h1 class="text-4xl font-bold mb-2"><%= @post.title %></h1>
    <div class="text-gray-600 text-sm mb-6 flex flex-grow justify-start content-center">
      <%= image_tag 'default_avatar.png', class: 'rounded-full shadow-sm w-16 h-auto' %>
      <%= link_to @post.user.username, user_path(@post.user), class: "hover:underline text-center" %> posted on <%= @post.created_at.strftime("%B %d, %Y") %>
    </div>

    <div class="prose max-w-none mb-8">
      <%= @post.content %>
    </div>



    <% if user_signed_in? && @post.user == current_user %>
      <div class="flex space-x-4">
        <%= link_to 'Edit Post', edit_post_path(@post), class: "text-blue-500 hover:underline" %>
      </div>
    <% end %>
  </div>

  <%# --- Comments Section --- %>
  <div class="mt-10">
    <h2 class="text-2xl font-bold mb-4">Comments</h2>

    <%# --- Form to Create a New Comment --- %>
    <% if user_signed_in? %>
      <div class="bg-white p-6 rounded-lg shadow-md mb-6">
        <h3 class="font-semibold mb-2">Leave a comment</h3>
        <%= form_with(model: [@post, Comment.new], class: "space-y-4") do |form| %>
          <div>
            <%= form.text_area :content, rows: 3, class: "block w-full rounded-md border-gray-300 shadow-sm sm:text-sm", placeholder: "What are your thoughts?" %>
          </div>
          <div>
            <%= form.submit "Post Comment", class: "cursor-pointer bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
          </div>
        <% end %>
      </div>
    <% else %>
        <p class="text-center my-4 p-4 bg-gray-100 rounded-lg">
          <%= link_to "Sign in", new_user_session_path, class: "font-bold text-blue-600 hover:underline" %> to leave a comment.
        </p>
    <% end %>

    <%# --- Render the Collection of Comments --- %>
    <div id="comments" class="space-y-6">
      <%= render @comments %>
    </div>
  </div>
</div>
