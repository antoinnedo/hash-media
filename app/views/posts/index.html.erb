<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">For you</h1>
    <% if user_signed_in? %>
      <%= link_to 'New Post', new_post_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <% end %>
  </div>

  <div class="space-y-6">
    <% @posts.each do |post| %>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-semibold mb-2">
          <%= link_to post.title, post, class: "hover:text-blue-600" %>
        </h2>
        <p class="text-gray-600 text-sm mb-4">
          By <%= link_to post.user.username, user_path(post.user) %> on <%= post.created_at.strftime("%B %d, %Y") %>
        </p>
        <div class="prose max-w-none mb-4">
          <%= truncate(post.content, length: 200) %>
        </div>

        <%# Show edit/delete buttons only to the post owner %>
        <% if user_signed_in? && post.user == current_user %>
          <div class="flex space-x-2">
            <%= link_to 'Edit', edit_post_path(post), class: "text-blue-500 hover:underline" %>
            <%= button_to 'Delete', post, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
          </div>
        <% end %>

        <%# app/views/posts/index.html.erb %>
        <%= render 'likes/like_section', post: post %>
      </div>
    <% end %>
  </div>
</div>
