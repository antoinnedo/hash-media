<%#
  This page is wrapped in a container to center the content
  and provide a neutral background color.
%>
<div class="bg-gray-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-lg mx-auto">

    <%# --- Main Update Profile Card --- %>
    <div class="bg-white p-8 rounded-xl shadow-lg space-y-6">
      <h2 class="text-3xl font-bold text-center text-gray-900">
        Edit Profile
      </h2>

      <%#
        The `form_for` helper is used here as generated by Devise.
        Note: `form_with` is the more modern equivalent.
        `multipart: true` is essential for file uploads to work.
      %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true, class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# --- Email Field --- %>
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 rounded-md">
            Currently waiting confirmation for: <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <%# --- New Password Field --- %>
        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <em class="text-xs text-gray-500">(leave blank if you don't want to change it)</em>
          <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
          <% if @minimum_password_length %>
            <p class="mt-2 text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <%# --- Password Confirmation Field --- %>
        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <%# --- Avatar Upload Field --- %>
        <div>
          <%= f.label :avatar, "Profile Picture", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%# Preview current avatar %>
          <% if resource.avatar.attached? %>
            <%= image_tag resource.avatar.variant(resize_to_limit: [100, 100]), class: "w-20 h-20 rounded-full object-cover mb-4" %>
          <% end %>
          <%= f.file_field :avatar, class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>
        </div>

        <%# --- Current Password Field (Required for changes) --- %>
        <div class="border-t border-gray-200 pt-6">
          <%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <em class="text-xs text-gray-500">(we need your current password to confirm your changes)</em>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <%# --- Submit Button --- %>
        <div>
          <%= f.submit "Update Profile", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# --- Cancel Account Card --- %>
    <div class="bg-white p-8 rounded-xl shadow-lg mt-8">
      <h3 class="text-xl font-bold text-gray-900">Cancel my account</h3>
      <p class="mt-2 text-sm text-gray-600">
        Unhappy with your account? You can permanently delete it below. This action cannot be undone.
      </p>
      <div class="mt-5">
        <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure you want to permanently delete your account?", turbo_confirm: "Are you sure you want to permanently delete your account?" }, method: :delete, class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 cursor-pointer" %>
      </div>
    </div>

    <%# --- Back Link --- %>
    <div class="mt-6 text-center">
      <%= link_to "Back", :back, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>

  </div>
</div>
